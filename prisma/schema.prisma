generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  concepts     String? // JSON array of the user's personal concept list
  createdAt    DateTime       @default(now())
  trades       Trade[]
  journal      JournalEntry[]
  settings     Settings?
  accounts     Account[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isCopy    Boolean  @default(false) // copy-trading account
  createdAt DateTime @default(now())
  trades    Trade[]

  @@unique([userId, name])
}

model Trade {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  symbol         String
  direction      String // "LONG" | "SHORT"
  entryPrice     Float
  exitPrice      Float?
  size           Float // contracts x $/point for futures, shares for stocks
  fees           Float     @default(0)
  entryDate      DateTime
  exitDate       DateTime?
  strategy       String?
  concepts       String? // comma-separated ICT concepts used on the trade
  notes          String?
  screenshotPath String?
  source         String    @default("manual") // "manual" | "csv" | "alpaca" | "tradovate" | "seed"
  externalId     String? // broker-side id, used to dedupe on sync/import
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, externalId])
  @@index([userId, symbol])
  @@index([userId, entryDate])
  @@index([userId, strategy])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String // "YYYY-MM-DD"
  mood       Int // 1..5
  discipline Int // 1..5
  notes      String?
  lessons    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model Settings {
  userId          String @id
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalance Float  @default(10000)
  currency        String @default("USD")
}
