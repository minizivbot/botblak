generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String? // null for Google-only accounts
  email        String?        @unique
  googleId     String?        @unique
  isAdmin      Boolean        @default(false)
  concepts     String? // JSON array of the user's personal concept list
  createdAt    DateTime       @default(now())
  trades       Trade[]
  journal      JournalEntry[]
  settings     Settings?
  accounts     Account[]
  brokerConnections BrokerConnection[]
}

model BrokerConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker      String // adapter id: "alpaca" | "tradovate"
  credentials String // AES-256-GCM encrypted JSON, key derived from AUTH_SECRET
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, broker])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isCopy    Boolean  @default(false) // copy-trading account
  // Prop-firm rules (all optional; set to turn on the prop tracker for this account)
  propStartBalance    Float? // account size the firm funded (e.g. 50000)
  propProfitTarget    Float? // profit goal in account currency (e.g. 3000)
  propMaxDrawdown     Float? // max trailing drawdown from peak (e.g. 2000)
  propDrawdownType    String? // "trailing" | "static"
  propMaxDailyLoss    Float? // per-account daily loss limit
  propFunded          Boolean @default(false) // auto-set true once the target is passed
  createdAt DateTime @default(now())
  trades    Trade[]

  @@unique([userId, name])
}

model Trade {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  symbol         String
  direction      String // "LONG" | "SHORT"
  entryPrice     Float
  exitPrice      Float?
  size           Float // contracts x $/point for futures, shares for stocks
  fees           Float     @default(0)
  entryDate      DateTime
  exitDate       DateTime?
  strategy       String?
  concepts       String? // comma-separated ICT concepts used on the trade
  notes          String?
  screenshotPath String?
  source         String    @default("manual") // "manual" | "csv" | "alpaca" | "tradovate" | "seed"
  externalId     String? // broker-side id, used to dedupe on sync/import
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, externalId])
  @@index([userId, symbol])
  @@index([userId, entryDate])
  @@index([userId, strategy])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String // "YYYY-MM-DD"
  mood       Int // 1..5
  discipline Int // 1..5
  notes      String?
  lessons    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model Settings {
  userId          String @id
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalance Float  @default(10000)
  currency        String @default("USD")
  maxDailyLoss    Float? // risk guard: stop-trading alert when today's losses reach this
  showOnLeaderboard Boolean @default(true) // opt out of the public leaderboard
}

model SiteConfig {
  id                 String  @id @default("singleton")
  announcement       String? // site-wide banner message; null = hidden
  announcementLevel  String  @default("info") // "info" | "warning" | "success"
  registrationOpen   Boolean @default(true) // allow new sign-ups
  leaderboardEnabled Boolean @default(true) // show the public leaderboard
  updatedAt          DateTime @updatedAt
}
