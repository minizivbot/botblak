# Copy this file to .env and fill in your values.

# SQLite database location (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# ----- Broker API keys (server-side only, never sent to the browser) -----

# Alpaca paper-trading keys — create them at https://app.alpaca.markets
# under "Paper Trading" -> "API Keys".
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
# Paper trading endpoint (default). Use https://api.alpaca.markets for live.
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# Tradovate (futures) — just your account username and password.
TRADOVATE_USERNAME=""
TRADOVATE_PASSWORD=""
# "demo" (default) or "live"
TRADOVATE_ENV="demo"
# Optional API key credentials if you have registered an API app:
TRADOVATE_CID=""
TRADOVATE_SEC=""
