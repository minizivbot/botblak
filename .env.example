# Copy this file to .env and fill in your values.

# SQLite database location (relative to the prisma/ directory).
# On Vercel this is instead the Neon Postgres URL (set automatically).
DATABASE_URL="file:./dev.db"

# Secret used to sign login session cookies. Any long random string.
# REQUIRED in production (e.g. run: openssl rand -hex 32). Optional locally.
AUTH_SECRET=""

# ----- Broker API keys (server-side only, never sent to the browser) -----

# Alpaca paper-trading keys — create them at https://app.alpaca.markets
# under "Paper Trading" -> "API Keys".
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
# Paper trading endpoint (default). Use https://api.alpaca.markets for live.
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# Tradovate (futures) — just your account username and password.
TRADOVATE_USERNAME=""
TRADOVATE_PASSWORD=""
# "demo" (default) or "live"
TRADOVATE_ENV="demo"
# Optional API key credentials if you have registered an API app:
TRADOVATE_CID=""
TRADOVATE_SEC=""

# ----- Google sign-in (optional) -----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (Web application; authorized redirect URI: https://YOUR-DOMAIN/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- Admin access -----
# Comma-separated usernames that get the admin panel (/admin). Alternatively,
# set a user's isAdmin flag in the database.
ADMIN_USERNAMES=""
# Or grant admin by Google email (comma-separated):
ADMIN_EMAILS=""

# ----- Push notifications (optional) -----
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ----- Stripe billing (optional; checkout activates when all are set) -----
# Dashboard -> Developers -> API keys / Webhooks. Create two subscription
# Prices (monthly $15, yearly $120) and paste their price_... ids below.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
# Optional: coupon id giving $10 off the first invoice => $5 first month
STRIPE_COUPON_INTRO=""

# ----- AI coach (optional; activates when set) -----
ANTHROPIC_API_KEY=""
